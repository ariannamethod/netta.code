  "source": "board = [obs['c' + str(index)] for index in range(16)]\nactions = ['up', 'left', 'right', 'down']\nhorizontal = 0\nvertical = 0\nfor row in range(4):\n    for column in range(3):\n        horizontal += abs(board[row * 4 + column] - board[row * 4 + column + 1])\n        vertical += abs(board[column * 4 + row] - board[(column + 1) * 4 + row])\nbest = -1000000\nfor direction in actions:\n    if obs['valid_' + direction]:\n        score = 0\n        for row in range(4):\n            for column in range(3):\n                first = row * 4 + column if direction in ('left', 'right') else column * 4 + row\n                second = first + 1 if direction in ('left', 'right') else first + 4\n                if board[first] == board[second] and board[first] > 0:\n                    score += board[first] * 4\n        if score > best:\n            best = score\n            action = direction\n"
}
